NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
TRUST_PROXY=false
SERVE_CLIENT=true
MONGO_URL=mongodb://127.0.0.1:27017/fitmate
JWT_SECRET=replace-with-output-from-openssl-rand-hex-32
GROQ_API_KEY=
GROQ_API_TWO=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For Render, set these in the service Environment settings instead of committing
# server/.env. Use NODE_ENV=production, SERVE_CLIENT=false, a generated JWT_SECRET,
# an Atlas URI ending in /fitmate, and the deployed frontend's HTTPS URL for
# CLIENT_URL.
